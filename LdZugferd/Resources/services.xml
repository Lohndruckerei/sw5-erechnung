<?xml version="1.0" encoding="utf-8"?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <service id="ld_zugferd.cii_xml_builder" class="LdZugferd\Components\CiiXmlBuilder"/>

        <service id="ld_zugferd.totals_calculator" class="LdZugferd\Components\TotalsCalculator"/>

        <service id="ld_zugferd.pdf_embedder" class="LdZugferd\Components\ZugferdPdfEmbedder"/>

        <service id="ld_zugferd.invoice_data_factory" class="LdZugferd\Components\InvoiceDataFactory">
            <argument type="service" id="ld_zugferd.totals_calculator"/>
            <argument type="service" id="dbal_connection"/>
        </service>

        <service id="ld_zugferd.subscriber.document_render" class="LdZugferd\Subscriber\DocumentRenderSubscriber">
            <argument type="service" id="ld_zugferd.invoice_data_factory"/>
            <argument type="service" id="ld_zugferd.cii_xml_builder"/>
            <argument type="service" id="ld_zugferd.pdf_embedder"/>
            <argument type="service" id="shopware.plugin.cached_config_reader"/>
            <argument type="service" id="pluginlogger"/>
            <argument>%ld_zugferd.plugin_name%</argument>
            <tag name="shopware.event_subscriber"/>
        </service>
    </services>
</container>
