# Kopieren nach .env und anpassen.

# Kopie des Shop-Verzeichnisses (Webroot des Live-Shops)
SHOP_DIR=./shop

# Gleiche PHP-Version wie der Live-Shop! (5.6: 7.2-7.4, 5.7: 7.4-8.2)
PHP_VERSION=7.4

# Adresse des Testshops. Bei anderem Port als 80 muss der Port im Host stehen.
HTTP_PORT=8080
SHOP_HOST=localhost:8080
MAIL_PORT=8025
# 127.0.0.1 = nur von diesem Rechner erreichbar. 0.0.0.0 = im ganzen Netzwerk (Vorsicht: Kundendaten!)
BIND_ADDRESS=127.0.0.1

# Kunden-E-Mail-Adressen beim Import durch kunde-<id>@example.invalid ersetzen (1 = ja)
ANONYMIZE_EMAILS=1

# Datenbank-Image passend zum Live-System, z. B. mysql:8.0, mysql:5.7, mariadb:10.6
DB_IMAGE=mysql:8.0

# UID/GID des eigenen Benutzers (Linux: `id -u` / `id -g`), damit Dateien beschreibbar bleiben
HOST_UID=1000
HOST_GID=1000

# ionCube Loader installieren (für verschlüsselte Store-Plugins)
INSTALL_IONCUBE=1

# Internetzugang für den Shop freischalten (normalerweise aus lassen):
# COMPOSE_FILE=docker-compose.yml:docker-compose.internet.yml
